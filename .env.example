# Se usa solo en un entorno seguro de generación local o CI; la web publicada
# no necesita esta clave. Nunca use un nombre VITE_*: esas variables se
# incrustan en el JavaScript público.
ELEVENLABS_API_KEY=

# OpenAlex (buscador global de tesis/disertaciones). Opcional en el plan free
# con mailto; la API key sube el cupo diario. Solo se lee en /api/thesis-search.
OPENALEX_API_KEY=
OPENALEX_MAILTO=contacto@tesis20.com

# Opcionales. Los valores por defecto son la voz «Jhenny Cozy»: femenina,
# tierna y con la entonación más viva de las ocho candidatas medidas,
# elegida para la narración del Nido.
NIDO_TTS_MODEL=eleven_multilingual_v2
NIDO_TTS_VOICE=EDitztUwd7lban76PAZs
NIDO_TTS_VOICE_NAME=Jhenny Cozy
